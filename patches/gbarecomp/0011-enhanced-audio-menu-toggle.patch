From 130a74405ded44a1afa94d7ea1d57fa89782f77c Mon Sep 17 00:00:00 2001
From: Saverio Moscardini <4923627+savemosca@users.noreply.github.com>
Date: Thu, 15 Oct 2026 12:00:11 +0200
Subject: [PATCH] Runtime menu: "Enhanced audio" toggle for the MP2K shadow
 mixer

The verified-enhancement shadow mixer could only be chosen at launch,
through [audio].shadow or GBARECOMP_AUDIO_SHADOW. Players who prefer it
had no way to switch it on, and no way to compare it with the original.

When the ROM links MP2K, the Audio section of the runtime menu now has
an "Enhanced audio" row:
- It switches the shadow at runtime. Turning it on starts from a fresh
  shadow, which has to prove itself again; turning it off returns to the
  canon mix at once.
- The choice is remembered in config.ini [Audio] enhanced, next to
  [Display], and wins over [audio].shadow on later launches.
  GBARECOMP_AUDIO_SHADOW still overrides both.
- Each switch is logged ("MP2K shadow mixer ARMED/off by the player").

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gba/gba_audio.cpp       | 14 ++++++++++++++
 src/gba/gba_audio.h         |  8 ++++++++
 src/runtime/host_window.cpp | 35 ++++++++++++++++++++++++++++++++++-
 src/runtime/host_window.h   |  5 +++++
 src/runtime/runtime.cpp     | 26 ++++++++++++++++++++++++++
 5 files changed, 87 insertions(+), 1 deletion(-)

diff --git a/src/gba/gba_audio.cpp b/src/gba/gba_audio.cpp
index 72125d1..e7330c4 100644
--- a/src/gba/gba_audio.cpp
+++ b/src/gba/gba_audio.cpp
@@ -944,6 +944,7 @@ void GbaAudio::configure_shadow(const std::vector<Mp2kSig>& sigs,
     shadow_mem_.rom = rom;       shadow_mem_.rom_len = rom_len;
     shadow_mem_.ewram = ewram;   shadow_mem_.ewram_len = ewram_len;
     shadow_mem_.iwram = iwram;   shadow_mem_.iwram_len = iwram_len;
+    shadow_sigs_ = sigs;
     shadow_.init(sigs);
     shadow_cursor_ = 0;
     shadow_samples_since_hook_ = 0;
@@ -963,6 +964,19 @@ void GbaAudio::configure_shadow(const std::vector<Mp2kSig>& sigs,
     }
 }
 
+void GbaAudio::set_shadow_enabled(bool on) {
+    if (!shadow_.armed() || on == shadow_enabled_) return;
+    if (on) {
+        shadow_ = Mp2kShadow{};  // voices and verifier start over
+        shadow_.init(shadow_sigs_);
+        shadow_cursor_ = 0;
+        shadow_samples_since_hook_ = 0;
+    }
+    shadow_enabled_ = on;
+    std::fprintf(stderr, "[audio] MP2K shadow mixer %s by the player\n",
+                 on ? "ARMED" : "off");
+}
+
 void GbaAudio::run_sample_event() {
     uint32_t samples = samples_per_event();
     CapSample caps[kMaxSamplesPerEvent] = {};
diff --git a/src/gba/gba_audio.h b/src/gba/gba_audio.h
index cdd0d27..aec5853 100644
--- a/src/gba/gba_audio.h
+++ b/src/gba/gba_audio.h
@@ -158,6 +158,13 @@ public:
                           const uint8_t* iwram, std::size_t iwram_len,
                           bool enable_request);
     bool shadow_live() const { return shadow_enabled_ && shadow_.live(); }
+    // The ROM links MP2K, so the shadow can be switched on.
+    bool shadow_available() const { return shadow_.armed(); }
+    bool shadow_enabled() const { return shadow_enabled_; }
+    // Player toggle (in-game menu). Switching on starts from a fresh shadow
+    // that has to prove itself again; switching off returns to the canon
+    // mix at once. No effect when the ROM does not link MP2K.
+    void set_shadow_enabled(bool on);
 
     // Save-state serialization. Captures the full guest mixer state
     // (channels, FIFOs, master, soundbias, sample accumulator) plus the
@@ -342,6 +349,7 @@ private:
 
     // ── MP2K HLE shadow (verified-enhancement; default off) ──────
     Mp2kShadow shadow_{};
+    std::vector<Mp2kSig> shadow_sigs_;  // kept to re-arm on a player toggle
     MemView    shadow_mem_{};
     bool       shadow_enabled_ = false;
     uint64_t   shadow_cursor_ = 0;          // running grid-sample count
diff --git a/src/runtime/host_window.cpp b/src/runtime/host_window.cpp
index 8420c9a..7c51aff 100644
--- a/src/runtime/host_window.cpp
+++ b/src/runtime/host_window.cpp
@@ -385,6 +385,9 @@ struct Backend {
     // Whole-multiple presentation; saved = the player chose it in the menu.
     bool integer_scale = false;
     bool integer_scale_saved = false;
+    // Enhanced (MP2K shadow) audio; saved = the player chose it in the menu.
+    bool audio_enhanced = false;
+    bool audio_enhanced_saved = false;
     bool touch_emulation = false;   // desktop mouse -> touch
     float px_per_mm = 96.0f / 25.4f;
     float logical_px_per_mm = 96.0f / 25.4f;  // SDL-reported (logical) density
@@ -1170,7 +1173,8 @@ void save_touch_config(const Backend* b) {
             const bool header = s != std::string::npos && line[s] == '[';
             if (header)
                 in_section = line.compare(s, 7, "[Touch]") == 0 ||
-                             line.compare(s, 9, "[Display]") == 0;
+                             line.compare(s, 9, "[Display]") == 0 ||
+                             line.compare(s, 7, "[Audio]") == 0;
             if (in_section) continue;
             kept.push_back(line);
         }
@@ -1191,6 +1195,10 @@ void save_touch_config(const Backend* b) {
         f << "\n[Display]\n";
         f << "integer_scale = " << (b->integer_scale ? 1 : 0) << "\n";
     }
+    if (b->audio_enhanced_saved) {
+        f << "\n[Audio]\n";
+        f << "enhanced = " << (b->audio_enhanced ? 1 : 0) << "\n";
+    }
 }
 
 // GBA KEYINPUT bit order: 0=A 1=B 2=Sel 3=Sta 4=Right 5=Left 6=Up 7=Down 8=R 9=L.
@@ -2749,6 +2757,29 @@ void HostWindow::set_touch_config_dir(const char* dir) {
             b->integer_scale_saved = true;
         }
     });
+    ini_scan_section((b->touch_config_dir + "/config.ini").c_str(), "Audio",
+                     [b](const char* key, const char* val) {
+        if (SDL_strcasecmp(key, "enhanced") == 0) {
+            b->audio_enhanced = std::atoi(val) != 0;
+            b->audio_enhanced_saved = true;
+        }
+    });
+}
+
+bool HostWindow::saved_audio_enhanced(bool& enabled) const {
+    if (!open_ || !impl_) return false;
+    auto* b = static_cast<const Backend*>(impl_);
+    if (!b->audio_enhanced_saved) return false;
+    enabled = b->audio_enhanced;
+    return true;
+}
+
+void HostWindow::save_audio_enhanced(bool enabled) {
+    if (!open_ || !impl_) return;
+    auto* b = static_cast<Backend*>(impl_);
+    b->audio_enhanced = enabled;
+    b->audio_enhanced_saved = true;
+    save_touch_config(b);
 }
 
 void HostWindow::set_integer_scale(bool enabled, bool persist) {
@@ -3304,6 +3335,8 @@ int  HostWindow::window_scale() const { return 1; }
 void HostWindow::set_linear_filter(bool /*enabled*/) {}
 bool HostWindow::linear_filter() const { return false; }
 void HostWindow::set_integer_scale(bool /*enabled*/, bool /*persist*/) {}
+bool HostWindow::saved_audio_enhanced(bool& /*enabled*/) const { return false; }
+void HostWindow::save_audio_enhanced(bool /*enabled*/) {}
 bool HostWindow::integer_scale() const { return false; }
 void HostWindow::set_audio_enabled(bool /*enabled*/) {}
 bool HostWindow::audio_enabled() const { return false; }
diff --git a/src/runtime/host_window.h b/src/runtime/host_window.h
index 1f4564b..699f57d 100644
--- a/src/runtime/host_window.h
+++ b/src/runtime/host_window.h
@@ -104,6 +104,11 @@ public:
     // the TOML default on later launches.
     void set_integer_scale(bool enabled, bool persist);
     bool integer_scale() const;
+    // The player's enhanced-audio (MP2K shadow) choice, remembered in
+    // config.ini [Audio] next to [Display]. saved_audio_enhanced() returns
+    // false until the player has chosen.
+    bool saved_audio_enhanced(bool& enabled) const;
+    void save_audio_enhanced(bool enabled);
     void set_audio_enabled(bool enabled);
     bool audio_enabled() const;
     void set_resize_driven_view(bool enabled);
diff --git a/src/runtime/runtime.cpp b/src/runtime/runtime.cpp
index 2b168ae..6df5fc0 100644
--- a/src/runtime/runtime.cpp
+++ b/src/runtime/runtime.cpp
@@ -244,9 +244,11 @@ struct Args {
 #define GBARECOMP_UI_KEY_FAST_FORWARD   "assist.fast_forward"
 #define GBARECOMP_UI_KEY_FAST_FORWARD_SPEED "assist.fast_forward_speed"
 #define GBARECOMP_UI_KEY_REWIND          "assist.rewind"
+#define GBARECOMP_UI_KEY_AUDIO_ENHANCED  "audio.enhanced"
 
 struct RuntimeUiContext {
     HostWindow* window = nullptr;
+    gba::GbaAudio* audio = nullptr;
     RecompRuntimeUi* ui = nullptr;
     float* gyro_sensitivity = nullptr;
     int view_mode = RECOMP_RUNTIME_UI_VIEW_NATIVE;
@@ -279,6 +281,8 @@ int runtime_ui_get(void* opaque, const RecompRuntimeUiItem* item, int* out) {
     else if (std::strcmp(item->key, RECOMP_RUNTIME_UI_KEY_VOLUME) == 0) *out = c->window->volume();
     else if (std::strcmp(item->key, GBARECOMP_UI_KEY_STATE_SLOT) == 0) *out = c->state_slot;
     else if (std::strcmp(item->key, GBARECOMP_UI_KEY_FPS) == 0) *out = c->window->fps_readout();
+    else if (std::strcmp(item->key, GBARECOMP_UI_KEY_AUDIO_ENHANCED) == 0 && c->audio)
+        *out = c->audio->shadow_enabled();
     else if (std::strcmp(item->key, GBARECOMP_UI_KEY_ASSIST_ENABLED) == 0)
         *out = c->assist_tools_enabled;
     else if (std::strcmp(item->key, GBARECOMP_UI_KEY_FAST_FORWARD) == 0)
@@ -317,6 +321,10 @@ int runtime_ui_set(void* opaque, const RecompRuntimeUiItem* item, int value) {
         c->state_slot = std::clamp(value, 1, c->state_slot_count);
     else if (std::strcmp(item->key, GBARECOMP_UI_KEY_FPS) == 0)
         c->window->set_fps_readout(value != 0);
+    else if (std::strcmp(item->key, GBARECOMP_UI_KEY_AUDIO_ENHANCED) == 0 && c->audio) {
+        c->audio->set_shadow_enabled(value != 0);
+        c->window->save_audio_enhanced(value != 0);
+    }
     else if (std::strcmp(item->key, GBARECOMP_UI_KEY_ASSIST_ENABLED) == 0) {
         c->assist_tools_enabled = value != 0;
         if (!c->assist_tools_enabled) c->fast_forward_latched = false;
@@ -2923,6 +2931,12 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
                                 opts.touch_pad_default, args.touch_emulation);
             win.set_integer_scale(args.integer_scale, /*persist=*/false);
             win.set_touch_config_dir(exe_dir.c_str());
+            // The player's menu choice wins over [audio].shadow;
+            // GBARECOMP_AUDIO_SHADOW still overrides both.
+            bool enhanced = false;
+            if (win.saved_audio_enhanced(enhanced) &&
+                !std::getenv("GBARECOMP_AUDIO_SHADOW"))
+                bus.audio().set_shadow_enabled(enhanced);
         }
         win.set_host_overlay(opts.host_overlay);
         win.set_view_margins(ppu.view_extra_left(), ppu.view_extra_right(),
@@ -2969,6 +2983,7 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
         win.set_fps_readout(opts.show_fps_by_default);
 #if defined(GBARECOMP_RUNTIME_UI)
         runtime_ui_context.window = &win;
+        runtime_ui_context.audio = &bus.audio();
         runtime_ui_context.gyro_sensitivity = &args.gyro_sensitivity;
         runtime_ui_context.assist_tools_exposed = opts.expose_assist_tools;
         runtime_ui_context.assist_tools_enabled =
@@ -3132,6 +3147,17 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
             }
         }
 
+        if (bus.audio().shadow_available()) {
+            RecompRuntimeUiItem enhanced_item{};
+            enhanced_item.key         = GBARECOMP_UI_KEY_AUDIO_ENHANCED;
+            enhanced_item.section     = "Audio";
+            enhanced_item.label       = "Enhanced audio";
+            enhanced_item.description =
+                "High-precision mix, without the 8-bit hiss.";
+            enhanced_item.type        = RECOMP_RUNTIME_UI_BOOL;
+            runtime_ui_extras.push_back(enhanced_item);
+        }
+
         RecompRuntimeUiItem fps_item{};
         fps_item.key         = GBARECOMP_UI_KEY_FPS;
         fps_item.section     = "Display";
