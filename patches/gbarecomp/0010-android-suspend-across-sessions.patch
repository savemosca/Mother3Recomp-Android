From d01c681c7a1cb53c98c4fabb813d5ab7f0e35bad Mon Sep 17 00:00:00 2001
From: Saverio Moscardini <4923627+savemosca@users.noreply.github.com>
Date: Thu, 15 Oct 2026 11:33:59 +0200
Subject: [PATCH 3/3] Android: keep the suspend state when a session ends in
 the background

On Android the process outlives a game session. When the Activity was
destroyed while the game was suspended in the background (the task
cleared by the launcher, or swiped away), two things went wrong:

- SDL queues SDL_QUIT and then SDL_APP_TERMINATING. wait_for_foreground()
  returned on SDL_QUIT, and the leftover SDL_APP_TERMINATING stayed in
  the process-wide event queue. The next session read it before its
  first frame and terminated at once.
- That empty session then wrote its never-booted machine as the suspend
  state, with the resume marker, over the previous session's state. The
  session after it "resumed" frame 0, so the player lost the progress
  made since the last in-game save.
- The session destroyed while suspended also cleared the resume marker
  on exit, although the state written when it entered the background
  was still current. The resume-on-launch path, meant for "killed in
  the background, or swiped away", only covered a process kill.

HostWindow::close() now flushes the event queue on Android, since every
event left in it belongs to the session that is ending. The runtime no
longer writes a suspend state for a session that has not run a frame,
and keeps the marker when a session is destroyed while suspended.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/host_window.cpp |  7 +++++++
 src/runtime/runtime.cpp     | 13 +++++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/src/runtime/host_window.cpp b/src/runtime/host_window.cpp
index e368024..8420c9a 100644
--- a/src/runtime/host_window.cpp
+++ b/src/runtime/host_window.cpp
@@ -2314,6 +2314,13 @@ void HostWindow::close() {
     delete b;
     impl_ = nullptr;
     open_ = false;
+#if defined(__ANDROID__)
+    // The process outlives the session and SDL's event queue with it. When
+    // the Activity is destroyed in the background, SDL queues SDL_QUIT then
+    // SDL_APP_TERMINATING; wait_for_foreground() returns on the first, and the
+    // second used to terminate the next session before its first frame.
+    SDL_FlushEvents(SDL_FIRSTEVENT, SDL_LASTEVENT);
+#endif
 }
 
 bool HostWindow::set_surface_size(int base_w, int base_h) {
diff --git a/src/runtime/runtime.cpp b/src/runtime/runtime.cpp
index a93d85e..2b168ae 100644
--- a/src/runtime/runtime.cpp
+++ b/src/runtime/runtime.cpp
@@ -3515,12 +3515,17 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
                                       ppu.frame_count());
             std::string e;
             const std::string state_path = suspend_state_path();
-            const bool suspended = do_savestate_save(state_path, e);
+            // A session stopped before its first frame has nothing to keep;
+            // its state would overwrite the previous session's suspend state
+            // (and the marker the next launch resumes from).
+            const bool ran = ppu.frame_count() > 0;
+            const bool suspended = ran && do_savestate_save(state_path, e);
+            if (!ran) e = "no frame run, previous state kept";
             if (suspended) {
                 std::ofstream marker(suspend_marker_path(), std::ios::trunc);
                 marker << ppu.frame_count() << "\n";
             }
-            if (ev.terminating) suspend_on_exit = suspended;
+            if (ev.terminating) suspend_on_exit = suspended || !ran;
             std::fprintf(stderr,
                          "[gbarecomp:runtime] %s: save=%s suspend_state=%s%s%s\n",
                          ev.terminating ? "terminating" : "entering background",
@@ -3534,7 +3539,11 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
                     clear_suspend_marker();
                     if (pacer) pacer->reset();
                 } else {
+                    // Destroyed while suspended (swiped away, or the Activity
+                    // finished): nothing ran since the state was written, so
+                    // the next launch resumes it.
                     host_quit = true;
+                    suspend_on_exit = suspended || !ran;
                 }
             }
         }
