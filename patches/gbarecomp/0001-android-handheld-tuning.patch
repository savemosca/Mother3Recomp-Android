diff --git a/src/runtime/mobile_platform.cpp b/src/runtime/mobile_platform.cpp
index 176a73b..2577fbb 100644
--- a/src/runtime/mobile_platform.cpp
+++ b/src/runtime/mobile_platform.cpp
@@ -7,6 +7,7 @@
 
 #if defined(__ANDROID__)
 #include <pthread.h>
+#include <sched.h>
 #include <unistd.h>
 
 #include <SDL.h>
@@ -23,7 +24,43 @@ struct StackedCall {
     char** argv = nullptr;
     int result = 1;
 };
+// GBARECOMP_BIG_CORES=1 keeps the game thread on the performance cluster
+// (every CPU whose max frequency is at least 80% of the fastest one), so the
+// scheduler cannot park the frame loop on a little core and drop frames while
+// the governor ramps up. Read from cpufreq, so no SoC table is needed.
+void pin_to_big_cores() {
+    const char* env = std::getenv("GBARECOMP_BIG_CORES");
+    if (!env || !*env || *env == '0') return;
+    const long cpus = sysconf(_SC_NPROCESSORS_CONF);
+    long freq[CPU_SETSIZE] = {};
+    long top = 0;
+    for (long cpu = 0; cpu < cpus && cpu < CPU_SETSIZE; ++cpu) {
+        char path[96];
+        std::snprintf(path, sizeof(path),
+                      "/sys/devices/system/cpu/cpu%ld/cpufreq/cpuinfo_max_freq", cpu);
+        if (std::FILE* f = std::fopen(path, "r")) {
+            if (std::fscanf(f, "%ld", &freq[cpu]) != 1) freq[cpu] = 0;
+            std::fclose(f);
+        }
+        if (freq[cpu] > top) top = freq[cpu];
+    }
+    if (top <= 0) return;
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    int picked = 0;
+    for (long cpu = 0; cpu < cpus && cpu < CPU_SETSIZE; ++cpu) {
+        if (freq[cpu] * 5 >= top * 4) {
+            CPU_SET(cpu, &set);
+            ++picked;
+        }
+    }
+    const bool ok = picked > 0 && sched_setaffinity(0, sizeof(set), &set) == 0;
+    std::fprintf(stderr, "mobile: game thread big-core affinity %s (%d cpus, max %ld kHz)\n",
+                 ok ? "set" : "unavailable", picked, top);
+}
+
 void* run_stacked(void* arg) {
+    pin_to_big_cores();
     auto* call = static_cast<StackedCall*>(arg);
     call->result = call->entry(call->argc, call->argv);
     return nullptr;
