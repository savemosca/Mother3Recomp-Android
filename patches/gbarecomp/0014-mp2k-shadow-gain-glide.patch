From a9bd72bd92dc4861cd0e231e48d5f90351c8a20a Mon Sep 17 00:00:00 2001
From: Saverio Moscardini <4923627+savemosca@users.noreply.github.com>
Date: Thu, 15 Oct 2026 16:13:02 +0200
Subject: [PATCH] MP2K shadow: glide output gains instead of stepping them

The hardware mixer applies a new envelope gain once per driver tick, and
cuts a channel the moment it ends. The 8-bit mix has those steps too,
but its quantization noise masks them. In the clean shadow they are
broadband clicks: a raspy crackle the player heard in MOTHER 3's
overworld music, and only with the shadow on.

Measured on an RG556 with per-tick voice events (about 45 s live):
- 212 driver ticks had an output jump over 200 (of 32767).
- 108 of the 151 ticks with a gain step on a continuing voice had one.
  That voice is typically one whose note was just released (status
  0x51/0x52), and the step reaches 15% of full scale.
- Most of the other big jumps were voices cut off at the tick.
- The spectrogram shows them as thin vertical lines.

The output path now glides each voice's gain toward the tick's target
(one pole, about 0.3 ms at 65536 Hz). Voices the driver has ended fade
out over a few milliseconds before they stop. The check copy that the
verifier compares with the canon still uses the driver's stepped gains,
and leaves an ending voice out at once, as the driver does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gba/mp2k_shadow.cpp | 37 ++++++++++++++++++++++++++++++++++---
 src/gba/mp2k_shadow.h   |  5 +++++
 2 files changed, 39 insertions(+), 3 deletions(-)

diff --git a/src/gba/mp2k_shadow.cpp b/src/gba/mp2k_shadow.cpp
index 95b2172..55e93f4 100644
--- a/src/gba/mp2k_shadow.cpp
+++ b/src/gba/mp2k_shadow.cpp
@@ -24,6 +24,13 @@ float clampf(float v, float lo, float hi) {
     return v < lo ? lo : (v > hi ? hi : v);
 }
 
+// One-pole glide of the output gains, ~0.3 ms at 65536 Hz: fast against a
+// 16.7 ms driver tick and an attack, slow enough that a gain step is no
+// longer a broadband click. The 8-bit hardware mix has the same steps, but
+// its quantization noise masks them; the clean shadow exposed them.
+constexpr float kGainGlide = 0.05f;
+constexpr float kSilentGain = 1.0f / 65536.0f;
+
 }  // namespace
 
 const uint8_t* MemView::slice(uint32_t addr, std::size_t len) const {
@@ -104,6 +111,12 @@ void Mp2kShadow::frame_hook(const MemView& mem, uint64_t audio_cursor, uint32_t
         if (!c) { v.on = false; continue; }
         uint8_t status = c[0x00];
         uint8_t ctype = c[0x01];
+        if ((status & 0xC7u) == 0 && v.on) {
+            // The driver ended it while mixing the last tick: fade out.
+            v.ending = true;
+            v.g0r = v.g0l = v.g1r = v.g1l = 0.0f;
+            continue;
+        }
         if ((status & 0xC7u) == 0 || (ctype & 0x07u) != 0) { v.on = false; continue; }
         if (ctype & 0x10u) { v.on = false; ++bad_waves_; continue; }  // reversed: not modeled
 
@@ -157,7 +170,15 @@ void Mp2kShadow::frame_hook(const MemView& mem, uint64_t audio_cursor, uint32_t
                 }
             }
         }
-        if (dead) { v.on = false; continue; }
+        if (dead) {
+            // Fade out what is still sounding instead of cutting it.
+            if (v.on) {
+                v.ending = true;
+                v.g0r = v.g0l = v.g1r = v.g1l = 0.0f;
+            }
+            continue;
+        }
+        v.ending = false;
 
         uint32_t env_next;
         if (iec) {
@@ -215,8 +236,18 @@ void Mp2kShadow::render(const MemView& mem, int8_t canon_a, int8_t canon_b,
         if (v.chk_acc <= 0.0) { v.chk_hold = s; v.chk_acc += mix_step_; }
         float gr = v.g0r + (v.g1r - v.g0r) * t;
         float gl = v.g0l + (v.g1l - v.g0l) * t;
-        right += s * gr * gain;
-        left += s * gl * gain;
+        v.out_r += (gr - v.out_r) * kGainGlide;
+        v.out_l += (gl - v.out_l) * kGainGlide;
+        right += s * v.out_r * gain;
+        left += s * v.out_l * gain;
+        if (v.ending) {
+            if (v.out_r < kSilentGain && v.out_l < kSilentGain) {
+                v.on = false;
+                v.ending = false;
+                v.out_r = v.out_l = 0.0f;
+            }
+            continue;  // already gone for the driver: not in the check copy
+        }
         chk_r += v.chk_hold * v.g0r * gain;
         chk_l += v.chk_hold * v.g0l * gain;
     }
diff --git a/src/gba/mp2k_shadow.h b/src/gba/mp2k_shadow.h
index 7c22109..72ca9ec 100644
--- a/src/gba/mp2k_shadow.h
+++ b/src/gba/mp2k_shadow.h
@@ -88,6 +88,11 @@ private:
         int8_t   blk[64] = {};
         float    chk_hold = 0.0f;    // canon-domain check-copy hold
         double   chk_acc = 0.0;
+        // Output gains as applied, gliding towards the tick's target so a
+        // gain step (note release, voice end) is not a click. The check
+        // copy keeps the driver's stepped gains.
+        float    out_r = 0.0f, out_l = 0.0f;
+        bool     ending = false;     // driver ended it; fading out, then off
     };
 
     bool note_on(Voice& v, const MemView& mem, uint8_t ctype, uint32_t count,
-- 
2.56.0

