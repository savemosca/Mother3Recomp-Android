     bool save_ok = flush_save_notify();
+    bus.audio().log_shadow_summary("exit");
     if (!suspend_on_exit) clear_suspend_marker();
     if (args.frames >= 0) {
         std::printf("%s start_frame=%llu end_frame=%llu presented=%llu "
