From c91647f04e1616407ff0ddd94f4716c426f576b1 Mon Sep 17 00:00:00 2001
From: Saverio Moscardini <4923627+savemosca@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:19:53 +0200
Subject: [PATCH] RunOptions::savestate_written / savestate_loaded

Game hooks after every engine savestate write and read (save-state slots,
the mobile suspend state, rewind's in-memory states reported as nullptr),
so game-owned host state such as an achievement runtime's partial progress
can be stored beside the state and restored with it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/runtime.cpp |  6 +++++-
 src/runtime/runtime.h   | 10 ++++++++++
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/runtime/runtime.cpp b/src/runtime/runtime.cpp
index 600dde9..e66df62 100644
--- a/src/runtime/runtime.cpp
+++ b/src/runtime/runtime.cpp
@@ -2331,7 +2331,9 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
     };
     auto do_savestate_save = [&](const std::string& path,
                                  std::string& e) -> bool {
-        return debug::save_state(path.c_str(), make_snapshot_ctx(), &e);
+        if (!debug::save_state(path.c_str(), make_snapshot_ctx(), &e)) return false;
+        if (opts.savestate_written) opts.savestate_written(path.c_str());
+        return true;
     };
     auto do_savestate_load = [&](const std::string& path,
                                  std::string& e) -> bool {
@@ -2359,6 +2361,7 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
 #if defined(GBARECOMP_WEB_HOST)
         bus.audio().discard_playback();
 #endif
+        if (opts.savestate_loaded) opts.savestate_loaded(path.c_str());
         return true;
     };
     auto do_savestate_save_bytes = [&](std::vector<uint8_t>& bytes,
@@ -2379,6 +2382,7 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
 #if defined(GBARECOMP_WEB_HOST)
         bus.audio().discard_playback();
 #endif
+        if (opts.savestate_loaded) opts.savestate_loaded(nullptr);
         return true;
     };
 
diff --git a/src/runtime/runtime.h b/src/runtime/runtime.h
index bd09e06..20bfa1d 100644
--- a/src/runtime/runtime.h
+++ b/src/runtime/runtime.h
@@ -173,6 +173,16 @@ struct RunOptions {
     // presentation. Null installs nothing.
     void (*vblank_frame)() = nullptr;
 
+    // Game-owned state that must travel with a savestate (an achievement
+    // runtime's partial progress, for instance). Called on the thread that
+    // wrote/read the state, with the guest stopped, after the engine's own
+    // state at `path` succeeded; the game keeps its data beside it (e.g.
+    // `path` + ".ra"). Covers save-state slots and the mobile suspend state.
+    // savestate_loaded(nullptr) reports an in-memory state (rewind), which
+    // has no file to pair with. Null installs nothing.
+    void (*savestate_written)(const char* path) = nullptr;
+    void (*savestate_loaded)(const char* path) = nullptr;
+
     // Gestures the game's policy owns (TouchClaim bits). An unclaimed
     // long-press still opens the runtime settings menu; a three-finger tap
     // always does.
-- 
