From 5c420fa0d6eef8e75a2fdca9acdb3af59756121c Mon Sep 17 00:00:00 2001
From: Saverio Moscardini <4923627+savemosca@users.noreply.github.com>
Date: Thu, 15 Oct 2026 17:29:07 +0200
Subject: [PATCH] GbaAudio: mid-event catch-up samples go through the MP2K
 shadow too

Samples are produced in two places:
- run_sample_event(), once per event;
- sample_until_current_time(), which mixes the event's slots up to
  "now" before a sound register write, so the write lands on the right
  sample.

Only the first knew about the MP2K shadow. The catch-up called
mix_one_sample() with the canon FIFO mix and did not render the shadow.
While the shadow substituted, every sound register write mid-event put
a few canon samples into the shadow's stream. The shadow runs about one
frame ahead of the canon (its tick is rendered at once; the hardware
buffers it through DMA), so those samples come from elsewhere in the
waveform. The result is one to three sample spikes, often repeated
values such as 6768, 6768 inside a smooth -4000 run.

In MOTHER 3 passages that write sound registers often, there were up to
640 spikes a second in the stream handed to the host, heard as a
continuous crackle with the shadow on only. The catch-up slots also
skipped the shadow's render, so its cursor fell behind, and their
capture-ring entries stayed empty.

Both paths now call mix_slot(), which renders the shadow, substitutes
or mixes canon, and fills the capture entry.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/gba/gba_audio.cpp | 114 +++++++++++++++++++++---------------------
 src/gba/gba_audio.h   |   5 ++
 2 files changed, 63 insertions(+), 56 deletions(-)

diff --git a/src/gba/gba_audio.cpp b/src/gba/gba_audio.cpp
index c247ea4..4303d45 100644
--- a/src/gba/gba_audio.cpp
+++ b/src/gba/gba_audio.cpp
@@ -650,8 +650,7 @@ void GbaAudio::sample_until_current_time() {
     uint32_t elapsed = cycle_accumulator_ / cycles_per_sample_;
     if (elapsed > slots) elapsed = slots;
     while (sample_index_ < elapsed) {
-        current_samples_[sample_index_] = mix_one_sample(sample_index_);
-        current_sample_rates_[sample_index_] = 1 + ((soundbias_ >> 14) & 3);
+        mix_slot(sample_index_);
         ++sample_index_;
     }
 }
@@ -1007,68 +1006,71 @@ void GbaAudio::log_shadow_summary(const char* when) const {
                  static_cast<unsigned long long>(shadow_.bad_waves()));
 }
 
+void GbaAudio::mix_slot(uint32_t slot) {
+    bool substitute = false;
+    float sl = 0.0f, sr = 0.0f;
+    if (shadow_enabled_) {
+        std::string degraded;
+        shadow_.render(shadow_mem_, fifo_a_.samples[slot],
+                       fifo_b_.samples[slot], sl, sr, degraded);
+        if (!degraded.empty()) {
+            std::fprintf(stderr, "[audio] MP2K shadow DEGRADED: %s\n",
+                         degraded.c_str());
+        }
+        ++shadow_cursor_;
+        substitute = shadow_.live();
+        ++shadow_enabled_samples_;
+        if (substitute) ++shadow_live_samples_;
+    }
+    // When the shadow is proven-live, mix PSG-only canon + the shadow's
+    // direct-sound render; otherwise the full canon mix (incl. FIFO).
+    ChannelTap tap;
+    int16_t s = mix_one_sample(slot, /*include_direct=*/!substitute, &tap);
+    if (substitute) {
+        // The shadow's right/left are MP2K's FIFO A/B streams in the bus
+        // float domain (full-scale DAC = 0.25, i.e. 128 in s8 units).
+        // Route and scale them exactly as mix_one_sample does the FIFO
+        // bytes (SOUNDCNT_H volume and L/R enables), so the music keeps
+        // its level against the PSG channels. The former fixed 24000
+        // scale played it about 12 dB low (a full-scale DAC gave 6000
+        // against the canon's 24576).
+        const float fifo_a = sr * 512.0f;
+        const float fifo_b = sl * 512.0f;
+        const float a = fifo_a * (direct_a_full_volume_ ? 4.0f : 2.0f);
+        const float b = fifo_b * (direct_b_full_volume_ ? 4.0f : 2.0f);
+        const float direct_left =
+            (direct_a_left_ ? a : 0.0f) + (direct_b_left_ ? b : 0.0f);
+        const float direct_right =
+            (direct_a_right_ ? a : 0.0f) + (direct_b_right_ ? b : 0.0f);
+        int32_t shadow_mix = static_cast<int32_t>(
+            (direct_left + direct_right) * 0.5f * 48.0f);
+        int32_t o = static_cast<int32_t>(s) + shadow_mix;
+        if (o > 32767) o = 32767;
+        if (o < -32767) o = -32767;
+        s = static_cast<int16_t>(o);
+    }
+    current_samples_[slot] = s;
+    current_sample_rates_[slot] = 1 + ((soundbias_ >> 14) & 3);
+    CapSample& cap = current_caps_[slot];
+    cap.mixed = s;
+    cap.ch[0] = tap.ch[0];
+    cap.ch[1] = tap.ch[1];
+    cap.ch[2] = tap.ch[2];
+    cap.ch[3] = tap.ch[3];
+    cap.direct_a = tap.direct_a;
+    cap.direct_b = tap.direct_b;
+}
+
 void GbaAudio::run_sample_event() {
     uint32_t samples = samples_per_event();
-    CapSample caps[kMaxSamplesPerEvent] = {};
     while (sample_index_ < samples) {
-        uint32_t slot = sample_index_;
-        bool substitute = false;
-        float sl = 0.0f, sr = 0.0f;
-        if (shadow_enabled_) {
-            std::string degraded;
-            shadow_.render(shadow_mem_, fifo_a_.samples[slot],
-                           fifo_b_.samples[slot], sl, sr, degraded);
-            if (!degraded.empty()) {
-                std::fprintf(stderr, "[audio] MP2K shadow DEGRADED: %s\n",
-                             degraded.c_str());
-            }
-            ++shadow_cursor_;
-            substitute = shadow_.live();
-            ++shadow_enabled_samples_;
-            if (substitute) ++shadow_live_samples_;
-        }
-        // When the shadow is proven-live, mix PSG-only canon + the shadow's
-        // direct-sound render; otherwise the full canon mix (incl. FIFO).
-        ChannelTap tap;
-        int16_t s = mix_one_sample(slot, /*include_direct=*/!substitute, &tap);
-        if (substitute) {
-            // The shadow's right/left are MP2K's FIFO A/B streams in the bus
-            // float domain (full-scale DAC = 0.25, i.e. 128 in s8 units).
-            // Route and scale them exactly as mix_one_sample does the FIFO
-            // bytes (SOUNDCNT_H volume and L/R enables), so the music keeps
-            // its level against the PSG channels. The former fixed 24000
-            // scale played it about 12 dB low (a full-scale DAC gave 6000
-            // against the canon's 24576).
-            const float fifo_a = sr * 512.0f;
-            const float fifo_b = sl * 512.0f;
-            const float a = fifo_a * (direct_a_full_volume_ ? 4.0f : 2.0f);
-            const float b = fifo_b * (direct_b_full_volume_ ? 4.0f : 2.0f);
-            const float direct_left =
-                (direct_a_left_ ? a : 0.0f) + (direct_b_left_ ? b : 0.0f);
-            const float direct_right =
-                (direct_a_right_ ? a : 0.0f) + (direct_b_right_ ? b : 0.0f);
-            int32_t shadow_mix = static_cast<int32_t>(
-                (direct_left + direct_right) * 0.5f * 48.0f);
-            int32_t o = static_cast<int32_t>(s) + shadow_mix;
-            if (o > 32767) o = 32767;
-            if (o < -32767) o = -32767;
-            s = static_cast<int16_t>(o);
-        }
-        current_samples_[slot] = s;
-        current_sample_rates_[slot] = 1 + ((soundbias_ >> 14) & 3);
-        caps[slot].mixed = s;
-        caps[slot].ch[0] = tap.ch[0];
-        caps[slot].ch[1] = tap.ch[1];
-        caps[slot].ch[2] = tap.ch[2];
-        caps[slot].ch[3] = tap.ch[3];
-        caps[slot].direct_a = tap.direct_a;
-        caps[slot].direct_b = tap.direct_b;
+        mix_slot(sample_index_);
         ++sample_index_;
     }
     for (uint32_t i = 0; i < samples; ++i) {
         // cap_push first (keyed by samples_generated_ pre-increment), then
         // ring_push which bumps samples_generated_ — keeps the two aligned.
-        cap_push(caps[i]);
+        cap_push(current_caps_[i]);
         ring_push(current_samples_[i], current_sample_rates_[i]);
     }
     sample_index_ = 0;
diff --git a/src/gba/gba_audio.h b/src/gba/gba_audio.h
index 56e2aca..1f95787 100644
--- a/src/gba/gba_audio.h
+++ b/src/gba/gba_audio.h
@@ -324,6 +324,7 @@ private:
     void cap_push(const CapSample& s);
     int16_t current_samples_[kMaxSamplesPerEvent] = {};
     uint8_t current_sample_rates_[kMaxSamplesPerEvent] = {};
+    CapSample current_caps_[kMaxSamplesPerEvent] = {};
     uint32_t sample_index_ = 0;
     std::vector<FifoTrace> trace_;
     uint32_t trace_write_ = 0;
@@ -338,6 +339,10 @@ private:
     uint32_t samples_per_event() const;
     uint32_t cycles_until_next_sample_event() const;
     void sample_until_current_time();
+    // Mixes one output slot of the current event: canon, or PSG plus the
+    // MP2K shadow while it substitutes. The single place both the event and
+    // the mid-event catch-up (sample_until_current_time) produce samples.
+    void mix_slot(uint32_t slot);
     void run_sample_event();
     void ch1_trigger();
     void ch2_trigger();
