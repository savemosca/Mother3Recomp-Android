From 16c420c6aaad8ea43d88630a63e69d7241846e9b Mon Sep 17 00:00:00 2001
From: Saverio Moscardini <4923627+savemosca@users.noreply.github.com>
Date: Tue, 13 Oct 2026 23:46:30 +0200
Subject: [PATCH] RunOptions::vblank_frame: per-frame game observer hook

Called once per emulated frame at VBlank start on the guest thread, after
the touch policy when both are set. Unlike input_frame it does not enable
the game touch policy, and unlike host_overlay it runs for every emulated
frame regardless of presentation. Intended for read-only watchers such as
an achievements runtime.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/runtime/runtime.cpp | 7 ++++++-
 src/runtime/runtime.h   | 7 +++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/runtime/runtime.cpp b/src/runtime/runtime.cpp
index c5de5ac..b6ac6af 100644
--- a/src/runtime/runtime.cpp
+++ b/src/runtime/runtime.cpp
@@ -2368,12 +2368,17 @@ int run_game(int argc, char** argv, const RunOptions& opts) {
     if (opts.input_frame) {
         TouchHub::instance().set_claims(opts.touch_gesture_claims);
         publish_headless_touch_presentation();
-        runtime_set_vblank_input_hook(run_touch_policy);
         if (!args.quiet)
             std::printf("touch_policy=ENABLED claims=0x%x%s\n",
                         static_cast<unsigned>(opts.touch_gesture_claims),
                         touch_policy_suspended ? " (suspended: input replay)" : "");
     }
+    if (opts.input_frame || opts.vblank_frame) {
+        runtime_set_vblank_input_hook([&run_touch_policy, &opts]() {
+            if (opts.input_frame) run_touch_policy();
+            if (opts.vblank_frame) opts.vblank_frame();
+        });
+    }
     struct ClearVblankInputHook {
         ~ClearVblankInputHook() { runtime_set_vblank_input_hook(nullptr); }
     } clear_vblank_input_hook;
diff --git a/src/runtime/runtime.h b/src/runtime/runtime.h
index d60ca8e..7d43087 100644
--- a/src/runtime/runtime.h
+++ b/src/runtime/runtime.h
@@ -148,6 +148,13 @@ struct RunOptions {
     // (the recorded trace already contains the composed keys).
     std::uint16_t (*input_frame)(const TouchFrameInfo* frame) = nullptr;
 
+    // Optional game-owned per-frame observer, called once per emulated frame
+    // at VBlank start on the guest thread (after input_frame when both are
+    // set). It may read guest memory but must not write it: achievement
+    // runtimes and similar watchers that need every frame, independent of
+    // presentation. Null installs nothing.
+    void (*vblank_frame)() = nullptr;
+
     // Gestures the game's policy owns (TouchClaim bits). An unclaimed
     // long-press still opens the runtime settings menu; a three-finger tap
     // always does.
